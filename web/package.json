{
  "name": "unionc-web",
  "private": true,
  "version": "0.3.5",
  "type": "module",
  "engines": {
    "node": ">=24",
    "npm": ">=10"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 3001",
    "lint": "eslint .",
    "test": "vitest run",
    "typecheck": "tsc -b",
    "build": "npm run typecheck && vite build --outDir dist.next && node ./scripts/publish-static.mjs",
    "preview": "vite preview --host 127.0.0.1 --port 3001"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.101.1",
    "lucide-react": "^1.21.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.5",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.7.0",
    "jsdom": "^30.0.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.1.0",
    "vitest": "^4.1.10"
  }
}
