# Union 唯一公网入口。前端、API、SSE 和 /modules/* 全部转发给同一 Union release。
# 不要给任何模块 worker 的 loopback listener 建站点或 upstream。
union.example.com {
	encode zstd gzip

	request_body {
		# Photo/Dufs 的实际上传上限还应按部署 profile 和业务容量单独设置。
		max_size 2GB
	}

	reverse_proxy 127.0.0.1:8081 {
		# 必须覆盖而不是追加；值与 Union 的 UNIONC_PROXY_SECRET 相同。
		header_up X-UnionC-Proxy-Secret {$UNIONC_PROXY_SECRET}
		# 支持 SSE 和流式上传/下载。
		flush_interval -1
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
	}
}
