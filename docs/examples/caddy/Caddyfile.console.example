# UnionC 管理台反向代理示例。
#
# 这份配置是**必需**的，不是可选加固：
#   - 生产环境（UNIONC_ENV=production）下 UnionC 拒绝绑定非回环地址，
#     只能经反代访问；
#   - 登录与 Agent 接口要求 X-Forwarded-Proto、X-Forwarded-For，以及反代覆盖写入的
#     X-UnionC-Proxy-Secret，缺任一项返回 421 Misdirected Request；
#   - X-Forwarded-For 是**硬要求**而非可选加固：按 IP 与按账号的登录限流全部
#     依赖它，缺失时这两层会静默失效，只剩全局兜底。因此服务端选择直接拒绝，
#     而不是降级运行——降级不产生任何信号，反而更危险；
#   - 限流读取 X-Forwarded-For 的**最右**一项，该实现假定前面恰好有一层
#     可信反代（见 server/src/auth/http.rs 的 client_ip）。
#
# Caddy 会自动设置 X-Forwarded-For / X-Forwarded-Proto / X-Forwarded-Host，
# 无需手写 header_up。

unionc.example.com {
	encode zstd gzip

	# ── 静态前端 ──────────────────────────────────────────────────────────
	# `cd web && npm run build` 的产物。UnionC 服务端只提供 API，不提供静态文件，
	# 因此前端由反代直接托管。SPA 需要把未命中的路径回落到 index.html，
	# 否则刷新子路由会 404。
		handle {
			root * /var/www/unionc
			try_files {path} /index.html
			# 静态文档不经过 UnionC API 进程，安全头必须在这里设置。后端 API 使用
			# `default-src 'none'`；前端文档需要加载同源 JS/CSS，因此使用独立策略。
			header {
				Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
				X-Content-Type-Options "nosniff"
				X-Frame-Options "DENY"
				Referrer-Policy "no-referrer"
				Cross-Origin-Resource-Policy "same-origin"
				Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
				Content-Security-Policy "default-src 'self'; base-uri 'none'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; connect-src 'self'; img-src 'self' data:"
			}
			file_server
		}

	# ── API ───────────────────────────────────────────────────────────────
	handle /api/* {
		reverse_proxy 127.0.0.1:8081 {
			# Caddy 与 UnionC 必须通过各自的服务环境获得同一随机值；覆盖而不是追加，
			# 防止外部请求自行注入。不要复用 UNIONC_SECRET_KEY。
			header_up X-UnionC-Proxy-Secret {$UNIONC_PROXY_SECRET}
			# SSE（/api/events）是长连接流，必须关闭缓冲，否则事件会被攒住
			# 直到缓冲区满才下发，前端表现为状态更新卡顿数十秒。
			flush_interval -1
		}
	}

	# 请求体上限。应用层按路由收紧到 4 KiB–1 MiB，这里只留协议编码余量。
	request_body {
		max_size 2MB
	}

	# API 响应的安全头由 UnionC 自身下发。上面 handle 内的 header 只作用于
	# 静态文件，不会放宽 API 的 `default-src 'none'`。
}

# ── 可选：只把 Agent 报告数据面拆到独立域名以强制 mTLS ────────────────────
# 见 Caddyfile.agent-api.example。首次 `/api/agent/v2/*` 配对仍留在本域名；尚未
# 配对的 Agent 不可能通过站点级客户端证书握手。若数据面也留在本域名，则
# /api/agent/v1/report 已被上面的 handle /api/* 覆盖，无需额外配置。
