# 可选的 Agent report 专用域名。它仍然反代 Union，而不是 Host worker 的私有 listener。
# 首次 pairing 必须留在无需客户端证书的主 Union 域名。
agents.example.com {
	tls {
		client_auth {
			mode require_and_verify
			trust_pool file {
				pem_file /etc/caddy/host-m-agent-ca.pem
			}
		}
	}

	request_body {
		max_size 512KB
	}

	handle /api/modules/host-monitoring/agent/v1/report {
		reverse_proxy 127.0.0.1:8081 {
			header_up X-UnionC-Proxy-Secret {$UNIONC_PROXY_SECRET}
		}
	}

	respond 404
}
