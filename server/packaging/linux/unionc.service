[Unit]
Description=Union service and private module supervisor
Documentation=https://github.com/isarmg/union-rust
After=network-online.target
Wants=network-online.target

[Service]
Type=notify
NotifyAccess=main
TimeoutStartSec=60s
User=unionc
Group=unionc
ExecStart=/opt/union/current/bin/unionc

# 数据目录必须显式声明；它包含核心私有状态与 modules/<id> 数据目录。
# PostgreSQL 连接由环境文件提供，Dufs 的 SQLite 只存在于它自己的模块目录。
Environment=UNIONC_DATA_DIR=/var/lib/unionc
WorkingDirectory=/var/lib/unionc
EnvironmentFile=-/etc/unionc/unionc.env
Environment=UNIONC_ENV=production

Restart=on-failure
RestartSec=5s

StateDirectory=unionc
StateDirectoryMode=0700
ConfigurationDirectory=unionc
UMask=0077

NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectKernelLogs=yes
ProtectClock=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
ReadWritePaths=/var/lib/unionc

[Install]
WantedBy=multi-user.target
