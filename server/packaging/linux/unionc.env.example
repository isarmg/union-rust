# UnionC 服务端环境配置。安装到 /etc/unionc/unionc.env（0640 root:unionc）。
#
# systemd unit 已经设置了 UNIONC_DATA_DIR=/var/lib/unionc，此处无需重复。

# Linux 包生命周期标记。安装脚本要求唯一且精确匹配当前包；请勿修改或删除。
# 直接运行二进制的非包部署不需要设置此变量。
UNIONC_PACKAGE_VERSION=0.3.2

# ── 必填 ──────────────────────────────────────────────────────────────────────

UNIONC_ENV=production

# AES-256 主密钥（32 字节的 Base64）。生产环境**必须**显式提供，不允许落盘自动生成。
#   openssl rand -base64 32
UNIONC_SECRET_KEY=CHANGE_ME

# 可信反向代理共享证明（64 位小写十六进制）。生成独立随机值，并在 Caddy 的
# UNIONC_PROXY_SECRET 环境中配置同一个值；不要复用上面的数据库加密密钥。
#   openssl rand -hex 32
# 故意保留为不满足长度校验的占位值，避免默认配置带已知共享证明成功启动。
UNIONC_PROXY_SECRET=CHANGE_ME

# ── 首次部署时临时设置，创建完管理员与数据库后请删除这两行并重启 ────────────────
#
# 生产环境要求显式开关才允许创建管理员配置和当前 schema 数据库：否则配置或数据库
# 找不到（很可能是 UNIONC_DATA_DIR 指错或数据丢失）会被静默地当成首次部署处理。
#UNIONC_ALLOW_BOOTSTRAP=1
#UNIONC_BOOTSTRAP_PASSWORD=CHANGE_ME_AT_LEAST_12_CHARS

# ── 可选 ──────────────────────────────────────────────────────────────────────

# 监听地址。生产环境强制绑定回环，只能经反向代理访问。
#UNIONC_SERVER_BIND=127.0.0.1
#UNIONC_SERVER_PORT=8081

# 保留期（天）。审计日志默认 90，遥测历史默认 30。
#UNIONC_RETENTION_DAYS=90
#UNIONC_TELEMETRY_RETENTION_DAYS=30

# 密钥轮换期间使用，格式 <key_id>:<base64>,<key_id>:<base64>
#UNIONC_SECRET_KEY_ID=primary
#UNIONC_SECRET_KEY_PREVIOUS=
