# Union Core 0.6 deployment environment. Builder decides which immutable module
# packages are present in a release; no environment variable selects business code.

# This marker identifies only the exact current package. Builder slot activation
# uses union-release.json instead; no cross-version migration is provided.
UNIONC_PACKAGE_VERSION=0.6.0

UNIONC_ENV=production
UNIONC_SECRET_KEY=CHANGE_ME_BASE64_32_BYTES
UNIONC_PROXY_SECRET=CHANGE_ME_64_LOWER_HEX

# Optional Core listener and retention settings.
#UNIONC_SERVER_BIND=127.0.0.1
#UNIONC_SERVER_PORT=8081
#UNIONC_RETENTION_DAYS=90

# Enable only for the first Core bootstrap, then remove both values.
#UNIONC_ALLOW_BOOTSTRAP=1
#UNIONC_BOOTSTRAP_PASSWORD=CHANGE_ME_AT_LEAST_12_CHARS

# Development/test-only package and runtime-state overrides. Production normally
# derives the read-only modules directory from the active Builder release and uses
# UNIONC_DATA_DIR for Core/plugin state.
#UNIONC_DATA_DIR=/var/lib/unionc
#UNIONC_BUNDLED_MODULES_DIR=/absolute/path/to/release/modules
#UNIONC_PLUGIN_STATE_DIR=/absolute/path/to/private/plugin-state

# Module configuration does not belong in this environment file. After login, use
# Settings -> Module management (or the authenticated
# /api/platform/modules/<id>/configuration API) to save JSON validated by each
# package's config/schema.json, then enable it. Sunshine, Host Monitoring, Sentinel
# and Photo must each receive a dedicated PostgreSQL database/role. Dufs receives
# its own rooted filesystem and SQLite state directory. Secrets are passed only to
# the target private process through the standard UNION_PLUGIN_CONFIG file.
# Provision/verify the four databases with docs/runbooks/postgresql-isolation.md;
# save each database_url in that module's configuration-center JSON, never here.

# SARMG_*_URL and module-specific UNIONC_* environment variables are intentionally
# unsupported. Worker executable, bind, routes and health contract come only from
# the Builder-verified package Manifest; all external traffic goes through Union.
