# Union full profile 环境模板。正式安装由 union-builder v1.0.0 激活完整 release；本文件
# 只能保存运行配置，不能选择模块或修改 worker 地址。

# 旧 Linux package lifecycle 仍用它校验同版本 marker；Builder 安装不读取此变量。
UNIONC_PACKAGE_VERSION=0.4.0

UNIONC_ENV=production

# Union 核心
UNIONC_SECRET_KEY=CHANGE_ME_BASE64_32_BYTES
UNIONC_PROXY_SECRET=CHANGE_ME_64_LOWER_HEX
#UNIONC_SERVER_BIND=127.0.0.1
#UNIONC_SERVER_PORT=8081
#UNIONC_RETENTION_DAYS=90
#UNIONC_MODULE_RUST_LOG=info

# 仅首次创建 Union 核心管理员时临时打开，完成后删除。
#UNIONC_ALLOW_BOOTSTRAP=1
#UNIONC_BOOTSTRAP_PASSWORD=CHANGE_ME_AT_LEAST_12_CHARS

# Sunshine（仅 profile 含 module-sunshine 时必填）
UNIONC_SUNSHINE_DATABASE_URL=postgresql://sunshine_runtime:CHANGE_ME@127.0.0.1/union
UNIONC_SUNSHINE_CREDENTIAL_KEY=CHANGE_ME_BASE64_32_BYTES
#UNIONC_SUNSHINE_CREDENTIAL_KEY_ID=primary

# Host monitoring（仅 profile 含 module-host-monitoring 时必填）
UNIONC_HOST_MONITORING_DATABASE_URL=postgresql://host_runtime:CHANGE_ME@127.0.0.1/union

# Sentinel（仅 profile 含 module-sentinel-monitor 时必填）
UNIONC_SENTINEL_DATABASE_URL=postgresql://sentinel_runtime:CHANGE_ME@127.0.0.1/sentinel
UNIONC_SENTINEL_APP_JWT_SECRET=CHANGE_ME
UNIONC_SENTINEL_CREDENTIALS_KEY=CHANGE_ME_BASE64_32_BYTES
#UNIONC_SENTINEL_BOOTSTRAP_ADMIN_EMAIL=admin@example.invalid
#UNIONC_SENTINEL_BOOTSTRAP_ADMIN_PASSWORD=CHANGE_ME
#UNIONC_SENTINEL_MEDIA_TOKEN_TTL_SECS=300
#UNIONC_SENTINEL_MEDIAMTX_API_URL=http://127.0.0.1:9997
#UNIONC_SENTINEL_MEDIAMTX_PLAYBACK_URL=rtsp://127.0.0.1:8554
#UNIONC_SENTINEL_MEDIAMTX_WEBRTC_URL=http://127.0.0.1:8889
#UNIONC_SENTINEL_MEDIAMTX_HLS_URL=http://127.0.0.1:8888
#UNIONC_SENTINEL_PUBLIC_WEBRTC_BASE_URL=/modules/sentinel-monitor/media-webrtc
#UNIONC_SENTINEL_PUBLIC_HLS_BASE_URL=/modules/sentinel-monitor/media-hls
#UNIONC_SENTINEL_STATUS_INTERVAL_SECS=10
#UNIONC_SENTINEL_RECONCILE_INTERVAL_SECS=30
#UNIONC_SENTINEL_REQUEST_TIMEOUT_SECS=10
#UNIONC_SENTINEL_ONVIF_DISCOVERY_TIMEOUT_MS=3000

# Photo Backup（仅 profile 含 module-photo-backup 时必填）
UNIONC_PHOTO_BACKUP_DATABASE_URL=postgresql://photo_runtime:CHANGE_ME@127.0.0.1/photo_backup
UNIONC_PHOTO_BACKUP_ADMIN_USERNAME=admin
UNIONC_PHOTO_BACKUP_ADMIN_PASSWORD=CHANGE_ME
#UNIONC_PHOTO_BACKUP_MAX_PART_BYTES=1073741824
#UNIONC_PHOTO_BACKUP_METRICS_TOKEN=CHANGE_ME

# Dufs 不使用数据库 URL。含 module-dufs 的部署必须另建：
#   $UNIONC_DATA_DIR/modules/dufs/dufs.yaml
# 该文件及父目录必须为服务 UID 所有、不可被其他用户写入。Dufs 使用自己的 SQLite 与文件根。

# 禁止设置任何 SARMG_*_URL。Union 会拒绝动态 worker URL；固定端口为
# Sentinel 18101、Photo 18102、Dufs 18103、Sunshine 18104、Host 18105。
