[Unit]
Description=UnionC read-only host telemetry agent
After=network-online.target
Wants=network-online.target

[Service]
Type=notify
NotifyAccess=main
TimeoutStartSec=30s
User=unionc-agent
Group=unionc-agent
ExecStart=/usr/bin/unionc-agent run --config /etc/unionc-agent/config.json
Restart=on-failure
RestartSec=10s

# StateDirectory 存放 v2 配对状态、per-host token 与 spool，必须 0700。
# 不显式声明时 systemd 用 0755，且**每次启动都会重设**——Agent 运行时虽然会
# chmod 0700，但那要等到第一次写凭据，中间存在窗口。与 unionc.service 保持一致。
StateDirectory=unionc-agent
StateDirectoryMode=0700
ConfigurationDirectory=unionc-agent
ConfigurationDirectoryMode=0750
UMask=0077

NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectKernelLogs=yes
ProtectClock=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
# 与 unionc.service 对齐。AF_NETLINK 是 sysinfo 枚举网络接口所需，去掉会让网卡指标消失。
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
SystemCallFilter=@system-service
ReadWritePaths=/var/lib/unionc-agent

[Install]
WantedBy=multi-user.target
