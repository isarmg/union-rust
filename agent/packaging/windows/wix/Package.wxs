<?xml version="1.0" encoding="utf-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util">
  <!--
    This package intentionally contains no PowerShell custom actions. The small native
    maintenance executable is embedded in the MSI Binary table and all privileged actions
    run deferred as LocalSystem. Its commands accept no caller-controlled paths; they derive
    the two fixed roots from Windows Known Folders and reject files/reparse points.

    The interactive tray companion is a separate GUI process in each signed-in user's session.
    It is never installed as, or launched by, the LocalService telemetry service.
  -->
  <Package
    Name="UnionC Agent"
    Manufacturer="UnionC"
    Version="$(var.ProductVersion)"
    Language="1033"
    Codepage="1252"
    Scope="perMachine"
    InstallerVersion="500"
    UpgradeCode="{A1AB822F-91BA-4116-A7E3-CE842B93E93C}"
    Compressed="yes">

    <SummaryInformation
      Description="UnionC read-only host telemetry agent"
      Keywords="UnionC,agent,telemetry,service"
      Manufacturer="UnionC" />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <!-- Another product version in this family must be removed explicitly; no migration runs. -->
    <Upgrade Id="{A1AB822F-91BA-4116-A7E3-CE842B93E93C}">
      <UpgradeVersion
        Minimum="0.0.0"
        IncludeMinimum="yes"
        OnlyDetect="yes"
        Property="UNIONC_OTHER_VERSION_FOUND" />
    </Upgrade>

    <Launch
      Condition="Installed OR NOT UNIONC_OTHER_VERSION_FOUND"
      Message="Another UnionC Agent version is installed. Uninstall it before installing this version; automatic migration is not supported." />
    <Launch
      Condition="VersionNT64"
      Message="[ProductName] requires 64-bit Windows." />
    <!-- ACL and state changes are explicitly transactional; never run without rollback. -->
    <Launch
      Condition="NOT RollbackDisabled"
      Message="[ProductName] setup requires Windows Installer rollback to remain enabled." />
    <Launch
      Condition="NOT PURGE OR PURGE = &quot;1&quot;"
      Message="PURGE accepts only the value 1. Omit it for a state-preserving uninstall." />

    <Property Id="ARPCONTACT" Value="UnionC maintainers" />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/isarmg/union-rust" />
    <Property Id="ARPNOMODIFY" Value="1" />
    <Property Id="ARPNOREPAIR" Value="1" />
    <Property Id="PURGE" Secure="yes" />
    <!-- Formatted only after costing; the WiX helper launches it with Explorer's normal token. -->
    <Property Id="WixUnelevatedShellExecTarget" Value="[#TrayExecutable]" />
    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="UnionC Agent" />
    </StandardDirectory>
    <StandardDirectory Id="CommonAppDataFolder">
      <Directory Id="STATEDIRECTORY" Name="UnionC Agent" />
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder" />

    <DirectoryRef Id="INSTALLFOLDER">
      <Component
        Id="AgentServiceComponent"
        Guid="{C7D313C7-1B72-4826-8FA4-5BF10928349E}"
        Bitness="always64">
        <File
          Id="AgentExecutable"
          Source="$(var.AgentExe)"
          Name="unionc-agent.exe"
          KeyPath="yes"
          Checksum="yes" />

        <ServiceInstall
          Id="UnionCAgentServiceInstall"
          Name="UnionCAgent"
          DisplayName="UnionC Agent"
          Description="Collects and securely reports read-only host telemetry to UnionC."
          Type="ownProcess"
          Start="auto"
          ErrorControl="normal"
          Account="NT AUTHORITY\LocalService"
          Arguments="--windows-service run --config &quot;[CommonAppDataFolder]UnionC Agent\config.json&quot;"
          Vital="yes">
          <util:ServiceConfig
            FirstFailureActionType="restart"
            SecondFailureActionType="restart"
            ThirdFailureActionType="restart"
            RestartServiceDelayInSeconds="60"
            ResetPeriodInDays="1" />
        </ServiceInstall>
        <ServiceControl
          Id="UnionCAgentServiceControl"
          Name="UnionCAgent"
          Start="install"
          Stop="both"
          Remove="uninstall"
          Wait="yes" />
      </Component>

      <Component
        Id="AgentTrayComponent"
        Guid="{882DF421-2758-42E4-95D4-730C2571803E}"
        Bitness="always64">
        <File
          Id="TrayExecutable"
          Source="$(var.TrayExe)"
          Name="unionc-agent-tray.exe"
          KeyPath="yes"
          Checksum="yes">
          <Shortcut
            Id="AgentTrayStartMenuShortcut"
            Directory="ProgramMenuFolder"
            Name="UnionC Agent"
            Description="Open UnionC Agent status and configuration"
            WorkingDirectory="INSTALLFOLDER"
            Arguments="--open"
            Advertise="yes" />
        </File>
        <!--
          A machine-wide Run value starts one unprivileged tray companion in every interactive
          user session. The fixed startup-mode argument never opens a browser; the explicit
          open mode is reserved for the user-invoked Start menu shortcut.
          Windows keeps each user's Startup Apps preference independently of MSI repair.
        -->
        <RegistryValue
          Root="HKLM"
          Key="Software\Microsoft\Windows\CurrentVersion\Run"
          Name="UnionCAgentTray"
          Type="string"
          Value="&quot;[INSTALLFOLDER]unionc-agent-tray.exe&quot; --startup" />
      </Component>
    </DirectoryRef>

    <!--
      This component records the fixed mutable root but deliberately creates or owns neither the
      directory nor any runtime file below it. The transactional native helper creates and secures
      the directory before StartServices. Windows Installer therefore cannot recreate it between
      purge quarantine and rollback, and preserves config, identity, credentials and spool on an
      ordinary uninstall.
    -->
    <DirectoryRef Id="STATEDIRECTORY">
      <Component
        Id="AgentStateDirectoryComponent"
        Guid="{55346DF8-69D2-425D-B574-F80379CB87A2}"
        Bitness="always64">
        <RegistryValue
          Root="HKLM"
          Key="Software\UnionC\Agent"
          Name="ManagedStateDirectory"
          Type="string"
          Value="[STATEDIRECTORY]"
          KeyPath="yes" />
      </Component>
    </DirectoryRef>

    <Feature
      Id="AgentFeature"
      Title="UnionC Agent"
      Level="1"
      AllowAbsent="no"
      AllowAdvertise="no">
      <ComponentRef Id="AgentServiceComponent" />
      <ComponentRef Id="AgentTrayComponent" />
      <ComponentRef Id="AgentStateDirectoryComponent" />
    </Feature>

    <!--
      Ask matching tray processes to exit before repair/uninstall replaces the image. The
      normal and elevated passes cover windows reachable from their respective installer
      contexts. Never force-terminate a remaining process (including one in another user
      session): Windows Installer follows its normal reboot path instead.
      The condition prevents a clean first install from touching an unrelated same-name process.
    -->
    <util:CloseApplication
      Id="CloseAgentTray"
      Target="unionc-agent-tray.exe"
      Description="UnionC Agent tray companion"
      Condition="Installed"
      CloseMessage="yes"
      ElevatedCloseMessage="yes"
      Timeout="10"
      RebootPrompt="yes" />

    <!-- The same helper is embedded once and is never left behind as another utility. -->
    <Binary Id="UnionCAgentMaintenance.exe" SourceFile="$(var.MaintenanceExe)" />

    <CustomAction
      Id="RollbackAgentInstall"
      BinaryRef="UnionCAgentMaintenance.exe"
      ExeCommand="rollback-install"
      Execute="rollback"
      Impersonate="no"
      Return="check" />
    <CustomAction
      Id="PrepareAgentInstall"
      BinaryRef="UnionCAgentMaintenance.exe"
      ExeCommand="prepare-install"
      Execute="deferred"
      Impersonate="no"
      Return="check" />
    <CustomAction
      Id="ApplyAgentInstall"
      BinaryRef="UnionCAgentMaintenance.exe"
      ExeCommand="apply-install"
      Execute="deferred"
      Impersonate="no"
      Return="check" />
    <CustomAction
      Id="CommitAgentInstall"
      BinaryRef="UnionCAgentMaintenance.exe"
      ExeCommand="commit-install"
      Execute="commit"
      Impersonate="no"
      Return="ignore" />

    <CustomAction
      Id="RollbackUninstallPreflight"
      BinaryRef="UnionCAgentMaintenance.exe"
      ExeCommand="rollback-uninstall-preflight"
      Execute="rollback"
      Impersonate="no"
      Return="check" />
    <CustomAction
      Id="PreflightAgentUninstall"
      BinaryRef="UnionCAgentMaintenance.exe"
      ExeCommand="preflight-uninstall"
      Execute="deferred"
      Impersonate="no"
      Return="check" />
    <CustomAction
      Id="RollbackPreservedState"
      BinaryRef="UnionCAgentMaintenance.exe"
      ExeCommand="rollback-uninstall"
      Execute="rollback"
      Impersonate="no"
      Return="check" />
    <CustomAction
      Id="PreserveAgentState"
      BinaryRef="UnionCAgentMaintenance.exe"
      ExeCommand="preserve-state"
      Execute="deferred"
      Impersonate="no"
      Return="check" />
    <CustomAction
      Id="CommitPreservedState"
      BinaryRef="UnionCAgentMaintenance.exe"
      ExeCommand="commit-uninstall"
      Execute="commit"
      Impersonate="no"
      Return="ignore" />
    <CustomAction
      Id="RollbackPurgedState"
      BinaryRef="UnionCAgentMaintenance.exe"
      ExeCommand="rollback-purge"
      Execute="rollback"
      Impersonate="no"
      Return="check" />
    <CustomAction
      Id="PreparePurgedState"
      BinaryRef="UnionCAgentMaintenance.exe"
      ExeCommand="prepare-purge"
      Execute="deferred"
      Impersonate="no"
      Return="check" />
    <CustomAction
      Id="CommitPurgedState"
      BinaryRef="UnionCAgentMaintenance.exe"
      ExeCommand="commit-purge"
      Execute="commit"
      Impersonate="no"
      Return="ignore" />

    <!--
      A fresh install may start the tray through WiX's unelevated ShellExecute helper,
      which obtains the normal Explorer token even when setup crossed UAC. Failure to provide an
      interactive shell is non-vital because the service is already installed and HKLM Run handles
      the next user logon. Fresh install uses this path only with interactive UI
      and only when no in-use image replacement was deferred; repair, uninstall and silent/SYSTEM
      deployment never request it. The helper accepts only a file target, so the tray deliberately
      treats its no-argument entry as the same browser-silent automatic mode as startup invocation.
    -->
    <CustomAction
      Id="LaunchAgentTray"
      BinaryRef="Wix4UtilCA_X64"
      DllEntry="WixUnelevatedShellExec"
      Execute="immediate"
      Impersonate="yes"
      Return="ignore" />

    <InstallExecuteSequence>
      <!--
        WiX Util 4.0.6 normally schedules Wix4CloseApplications_X64 immediately before
        InstallFiles. That is early enough while installing, but too late while uninstalling:
        the standard RemoveFiles action precedes InstallFiles and could already have encountered
        the running tray image. Override the extension's explicitly-overridable sequence row so
        both the user-context and elevated close passes are scheduled inside the transaction
        before StopServices, RemoveShortcuts and RemoveFiles on repair/uninstall paths.
      -->
      <Custom
        Action="Wix4CloseApplications_X64"
        After="InstallInitialize"
        Condition="VersionNT &gt; 400" />

      <!--
        Register rollback, then snapshot current state before Windows Installer reaches
        StopServices. This captures the managed service's running state before repair changes it,
        and is also earlier than directory/file installation.
        REMOVE is reliable only after InstallValidate; every action below is later.
      -->
      <Custom
        Action="RollbackAgentInstall"
        Before="PrepareAgentInstall"
        Condition="NOT REMOVE~=&quot;ALL&quot;" />
      <Custom
        Action="PrepareAgentInstall"
        Before="StopServices"
        Condition="NOT REMOVE~=&quot;ALL&quot;" />
      <Custom
        Action="ApplyAgentInstall"
        After="InstallServices"
        Condition="NOT REMOVE~=&quot;ALL&quot;" />
      <Custom
        Action="CommitAgentInstall"
        After="ApplyAgentInstall"
        Condition="NOT REMOVE~=&quot;ALL&quot;" />
      <Custom
        Action="LaunchAgentTray"
        After="InstallFinalize"
        Condition="NOT Installed AND NOT REMOVE~=&quot;ALL&quot; AND UILevel &gt;= 4 AND NOT ReplacedInUseFiles" />

      <!--
        Standard MSI service/file removal is name/path based, so it must never run until the
        helper has rejected a replaced service and file/junction/reparse root. Register a narrow
        preflight rollback first so a preflight failure can remove its journal. State rollback is
        deliberately registered only after StopServices: reverse execution then restores the MSI
        service before the helper restores state ACLs, SID settings and prior running state.
      -->
      <Custom
        Action="RollbackUninstallPreflight"
        Before="PreflightAgentUninstall"
        Condition="REMOVE~=&quot;ALL&quot;" />
      <Custom
        Action="PreflightAgentUninstall"
        Before="StopServices"
        Condition="REMOVE~=&quot;ALL&quot;" />
      <Custom
        Action="RollbackPreservedState"
        After="StopServices"
        Condition="REMOVE~=&quot;ALL&quot; AND NOT (PURGE = &quot;1&quot;)" />
      <Custom
        Action="PreserveAgentState"
        After="RollbackPreservedState"
        Condition="REMOVE~=&quot;ALL&quot; AND NOT (PURGE = &quot;1&quot;)" />
      <Custom
        Action="CommitPreservedState"
        After="PreserveAgentState"
        Condition="REMOVE~=&quot;ALL&quot; AND NOT (PURGE = &quot;1&quot;)" />

      <!--
        Purge first performs a full no-reparse scan and atomically quarantines the state root.
        Rollback can restore that rename until the transaction reaches commit. Commit deletion is
        irreversible: if it cannot finish, the protected quarantine may remain for explicit
        administrator cleanup, but Windows Installer must not roll an already uninstalled product
        back onto a partially deleted state tree.
        Version migration is not supported, so no upgrade transaction can enter this path.
      -->
      <Custom
        Action="RollbackPurgedState"
        After="StopServices"
        Condition="REMOVE~=&quot;ALL&quot; AND PURGE = &quot;1&quot;" />
      <Custom
        Action="PreparePurgedState"
        After="RollbackPurgedState"
        Condition="REMOVE~=&quot;ALL&quot; AND PURGE = &quot;1&quot;" />
      <Custom
        Action="CommitPurgedState"
        After="PreparePurgedState"
        Condition="REMOVE~=&quot;ALL&quot; AND PURGE = &quot;1&quot;" />
    </InstallExecuteSequence>
  </Package>
</Wix>
