<Project Sdk="WixToolset.Sdk/4.0.6">
  <PropertyGroup>
    <OutputType>Package</OutputType>
    <InstallerPlatform>x64</InstallerPlatform>
    <Platform>x64</Platform>
    <Cultures>en-US</Cultures>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>

    <!-- Callers must provide x64 executables for this exact package version. -->
    <ProductVersion Condition="'$(ProductVersion)' == ''">0.5.0</ProductVersion>
    <AgentExe Condition="'$(AgentExe)' == ''">$(MSBuildThisFileDirectory)..\..\..\..\target\x86_64-pc-windows-msvc\release\unionc-agent.exe</AgentExe>
    <MaintenanceExe Condition="'$(MaintenanceExe)' == ''">$(MSBuildThisFileDirectory)..\..\..\..\target\x86_64-pc-windows-msvc\release\unionc-agent-maintenance.exe</MaintenanceExe>
    <TrayExe Condition="'$(TrayExe)' == ''">$(MSBuildThisFileDirectory)..\..\..\..\target\x86_64-pc-windows-msvc\release\unionc-agent-tray.exe</TrayExe>
    <OutputName>UnionC-Agent-$(ProductVersion)-x64</OutputName>
    <DefineConstants>$(DefineConstants);ProductVersion=$(ProductVersion);AgentExe=$(AgentExe);MaintenanceExe=$(MaintenanceExe);TrayExe=$(TrayExe)</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="WixToolset.Util.wixext" Version="4.0.6" />
  </ItemGroup>

  <Target Name="ValidateInputs" BeforeTargets="BeforeBuild">
    <Error
      Condition="$([System.Text.RegularExpressions.Regex]::IsMatch('$(ProductVersion)', '^\d+\.\d+\.\d+$')) != true"
      Text="ProductVersion must contain exactly three numeric fields (for example 0.5.0)." />
    <Error
      Condition="$([System.Text.RegularExpressions.Regex]::IsMatch('$(ProductVersion)', '^\d+\.\d+\.\d+$')) AND $([System.Version]::Parse('$(ProductVersion)').Major) &gt; 255"
      Text="The ProductVersion major field must be between 0 and 255." />
    <Error
      Condition="$([System.Text.RegularExpressions.Regex]::IsMatch('$(ProductVersion)', '^\d+\.\d+\.\d+$')) AND $([System.Version]::Parse('$(ProductVersion)').Minor) &gt; 255"
      Text="The ProductVersion minor field must be between 0 and 255." />
    <Error
      Condition="$([System.Text.RegularExpressions.Regex]::IsMatch('$(ProductVersion)', '^\d+\.\d+\.\d+$')) AND $([System.Version]::Parse('$(ProductVersion)').Build) &gt; 65535"
      Text="The ProductVersion build field must be between 0 and 65535." />
    <Error Condition="!Exists('$(AgentExe)')" Text="AgentExe does not exist: $(AgentExe)" />
    <Error Condition="!Exists('$(MaintenanceExe)')" Text="MaintenanceExe does not exist: $(MaintenanceExe)" />
    <Error Condition="!Exists('$(TrayExe)')" Text="TrayExe does not exist: $(TrayExe)" />
    <Exec
      Command="&quot;$(AgentExe)&quot; --version"
      ConsoleToMSBuild="true"
      StandardOutputImportance="Low">
      <Output TaskParameter="ConsoleOutput" PropertyName="DetectedAgentVersion" />
    </Exec>
    <Error
      Condition="'$(DetectedAgentVersion)' != 'unionc-agent $(ProductVersion)'"
      Text="ProductVersion $(ProductVersion) does not match AgentExe version '$(DetectedAgentVersion)'. Build all payloads from the current package before creating the MSI." />
  </Target>
</Project>
